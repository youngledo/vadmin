        <mxCell id="9" value="Spring adapter&#xa;Security, persistence, Flyway, observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="7"><mxGeometry x="80" y="230" width="310" height="80" as="geometry"/></mxCell>
